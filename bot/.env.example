# Copy this file to bot/.env and fill in the values locally.
BOT_TOKEN=
ADMIN_CHAT_ID=
WEBAPP_URL=https://your-project.vercel.app

# Optional. Relative to bot/; the default is data/leads.db.
DB_PATH=data/leads.db

# Optional. Comma-separated Telegram user IDs for private stats access.
STATS_VIEWER_IDS=

# Optional. Public HTTPS URL of the admin Mini App.
PANEL_URL=

# Optional. Local port for the admin panel server.
PANEL_PORT=8090
