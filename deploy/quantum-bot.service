[Unit]
Description=QUANTUM Psychology Telegram bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=quantum
Group=quantum
WorkingDirectory=/opt/quantum-bot/bot
ExecStart=/opt/quantum-bot/.venv/bin/python bot.py
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/quantum-bot/bot/data

[Install]
WantedBy=multi-user.target
