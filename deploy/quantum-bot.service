[Unit]
Description=QUANTUM Psychology Telegram bot
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
User=quantum-bot
Group=quantum-bot
WorkingDirectory=/opt/quantum-bot/bot
ExecStart=/opt/quantum-bot/.venv/bin/python bot.py
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/quantum-bot/bot/data

[Install]
WantedBy=multi-user.target
